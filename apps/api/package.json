{
  "name": "fogo-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:generate": "npm run build && node --env-file=../../.env ../../node_modules/typeorm/cli.js migration:generate -d dist/database/data-source.js",
    "migration:run": "npm run build && node --env-file=../../.env ../../node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:show": "npm run build && node --env-file=../../.env ../../node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "seed": "npm run build && node --env-file=../../.env dist/database/seed.js",
    "seed:intelligence": "npm run build && node --env-file=../../.env dist/database/seed-intelligence-history.js"
  },
  "dependencies": {
    "@fogo/contracts": "0.1.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.15",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
