{
  "name": "fogo-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node ../../scripts/copy-maplibre-worker.mjs && node ../../scripts/prepare-web-dev.mjs",
    "prebuild": "node ../../scripts/copy-maplibre-worker.mjs",
    "prewatch": "node ../../scripts/copy-maplibre-worker.mjs",
    "start": "ng serve --host 127.0.0.1 --proxy-config .angular/fogo-proxy.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "oxlint --type-aware src/",
    "test": "ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "maplibre-gl": "^6.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
